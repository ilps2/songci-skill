{
  "name": "tianqing-design-language",
  "version": "1.0.0",
  "description": "天青 · 宋瓷 UI 设计语言 — 从宋代瓷器美学提取的设计令牌（Style Dictionary / Figma Tokens 兼容格式）",
  "extend": {
    "color": {
      "primary": {
        "50":  { "value": "#F0F6F8", "type": "color", "description": "天青 50 · 汝窑（最浅）" },
        "100": { "value": "#DCECEF", "type": "color", "description": "天青 100" },
        "200": { "value": "#B9CFD9", "type": "color", "description": "淡天青 · 辅助" },
        "300": { "value": "#9FB9C6", "type": "color", "description": "天青 300 · 暗色模式主色" },
        "400": { "value": "#8CAEBD", "type": "color", "description": "天青 400" },
        "500": { "value": "#7FA8B8", "type": "color", "description": "天青 · 全局主色（汝窑）" },
        "600": { "value": "#648C9E", "type": "color", "description": "深天青 · Hover/强调" },
        "700": { "value": "#4E7486", "type": "color", "description": "天青 700" },
        "800": { "value": "#3E5F6E", "type": "color", "description": "天青 800" },
        "900": { "value": "#2C4550", "type": "color", "description": "天青 900（最深）" }
      },
      "secondary": {
        "400": { "value": "#B5CFC8", "type": "color", "description": "粉青 · 龙泉 · 次级强调" }
      },
      "success": {
        "200": { "value": "#AABFA3", "type": "color", "description": "浅豆青 · 成功态浅底（耀州）" },
        "500": { "value": "#5C7A52", "type": "color", "description": "豆青 · 成功态（耀州）" }
      },
      "warning": {
        "500": { "value": "#A47C48", "type": "color", "description": "茶褐 · 警示/点缀（茶席）" }
      },
      "danger": {
        "500": { "value": "#A65E44", "type": "color", "description": "窑变赭 · 错误（钧窑窑变）" }
      },
      "neutral": {
        "0":   { "value": "#F7F4EC", "type": "color", "description": "象牙白 · 表面（定窑）" },
        "50":  { "value": "#EEF1F3", "type": "color", "description": "月白 · 背景（官窑）" },
        "100": { "value": "#E5E0D4", "type": "color", "description": "汝釉 · 边框" },
        "200": { "value": "#D6D0C0", "type": "color", "description": "灰釉 · 分隔" },
        "400": { "value": "#8A8478", "type": "color", "description": "灰陶 · 弱化文字" },
        "700": { "value": "#4A453D", "type": "color", "description": "墨 · 次级文字" },
        "900": { "value": "#22201C", "type": "color", "description": "黑釉 · 主文字（建窑）" }
      },
      "dark": {
        "bg":     { "value": "#17150F", "type": "color", "description": "黑釉底 · 暗色模式背景" },
        "surface":{ "value": "#221F18", "type": "color", "description": "暗色模式表面" },
        "border": { "value": "#3A352B", "type": "color", "description": "暗色模式边框" },
        "text":   { "value": "#EDE8DC", "type": "color", "description": "暗色模式主文字" },
        "text2":  { "value": "#B8B0A0", "type": "color", "description": "暗色模式次级文字" }
      }
    },
    "fontFamily": {
      "serif": { "value": "'Noto Serif SC','Songti SC','STSong','SimSun',serif", "type": "fontFamily", "description": "标题衬线" },
      "sans":  { "value": "'Noto Sans SC','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif", "type": "fontFamily", "description": "正文无衬线" },
      "mono":  { "value": "'JetBrains Mono','SF Mono',Consolas,monospace", "type": "fontFamily", "description": "数字/代码" }
    },
    "fontSize": {
      "display": { "value": "40px", "type": "fontSize", "description": "品牌大标题" },
      "h1":      { "value": "30px", "type": "fontSize", "description": "页面标题" },
      "h2":      { "value": "22px", "type": "fontSize", "description": "区块标题" },
      "h3":      { "value": "17px", "type": "fontSize", "description": "卡片标题" },
      "body":    { "value": "15px", "type": "fontSize", "description": "正文" },
      "caption": { "value": "12px", "type": "fontSize", "description": "辅助说明" }
    },
    "lineHeight": {
      "display": { "value": 1.4, "type": "lineHeight" },
      "h1":      { "value": 1.47, "type": "lineHeight" },
      "h2":      { "value": 1.55, "type": "lineHeight" },
      "h3":      { "value": 1.65, "type": "lineHeight" },
      "body":    { "value": 1.73, "type": "lineHeight" },
      "caption": { "value": 1.5, "type": "lineHeight" }
    },
    "borderRadius": {
      "sm":   { "value": "8px",  "type": "borderRadius", "description": "标签" },
      "md":   { "value": "14px", "type": "borderRadius", "description": "按钮/输入框" },
      "lg":   { "value": "22px", "type": "borderRadius", "description": "卡片" },
      "full": { "value": "999px","type": "borderRadius", "description": "胶囊" }
    },
    "boxShadow": {
      "soft":  { "value": "0 8px 24px rgba(34,32,28,.07), 0 2px 6px rgba(34,32,28,.04)", "type": "boxShadow", "description": "默认卡片" },
      "lift":  { "value": "0 16px 40px rgba(100,140,158,.16), 0 4px 12px rgba(34,32,28,.05)", "type": "boxShadow", "description": "悬停" },
      "modal": { "value": "0 24px 64px rgba(34,32,28,.18)", "type": "boxShadow", "description": "弹窗" }
    },
    "spacing": {
      "1": { "value": "4px",  "type": "spacing" },
      "2": { "value": "8px",  "type": "spacing" },
      "3": { "value": "16px", "type": "spacing" },
      "4": { "value": "24px", "type": "spacing" },
      "5": { "value": "40px", "type": "spacing" },
      "6": { "value": "64px", "type": "spacing" },
      "7": { "value": "96px", "type": "spacing", "description": "大留白" }
    },
    "duration": {
      "fast": { "value": "200ms", "type": "duration", "description": "微交互" },
      "base": { "value": "350ms", "type": "duration", "description": "常规过渡" },
      "slow": { "value": "500ms", "type": "duration", "description": "页面转场" }
    },
    "easing": {
      "default": { "value": "cubic-bezier(0.25, 0.1, 0.25, 1)", "type": "easing" },
      "silk":    { "value": "cubic-bezier(0.45, 0.05, 0.25, 1)", "type": "easing", "description": "釉面流动感" }
    }
  },
  "componentPresets": {
    "btnPrimary": {
      "backgroundColor": "{color.primary.500}",
      "textColor": "#FFFFFF",
      "borderRadius": "{borderRadius.full}",
      "padding": "10px 24px",
      "hoverBackground": "{color.primary.600}",
      "shadow": "0 4px 14px rgba(127,168,184,.35)"
    },
    "btnGhost": {
      "backgroundColor": "transparent",
      "textColor": "{color.primary.600}",
      "border": "1px solid {color.primary.200}",
      "borderRadius": "{borderRadius.full}"
    },
    "card": {
      "backgroundColor": "{color.neutral.0}",
      "border": "1px solid {color.neutral.100}",
      "borderRadius": "{borderRadius.lg}",
      "shadow": "{boxShadow.soft}",
      "padding": "{spacing.4}"
    },
    "input": {
      "backgroundColor": "#FFFDF7",
      "border": "1px solid {color.neutral.100}",
      "borderRadius": "{borderRadius.md}",
      "focusBorder": "{color.primary.500}",
      "focusRing": "0 0 0 4px rgba(127,168,184,.15)"
    },
    "chart": {
      "primarySeries": ["{color.primary.500}", "{color.primary.700}"],
      "secondarySeries": ["{color.secondary.400}", "{color.success.500}"],
      "tertiarySeries": ["{color.warning.500}", "{color.danger.500}"],
      "gridLine": "rgba(229,224,212,.6)",
      "highlight": "{color.warning.500}"
    }
  }
}
